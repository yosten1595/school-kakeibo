# このファイルを terraform.tfvars にコピーして書き換える。terraform.tfvars は Git に含めない。

# このPCのグローバル IP。curl https://checkip.amazonaws.com で調べて、末尾に /32 を付ける
allowed_cidr = "203.0.113.10/32"

# 予算アラートの送り先（書かなければ予算アラートは作らない）
alert_email = "you@example.com"

# RDS で使える MySQL のバージョン（aws rds describe-db-engine-versions で確認）
# db_engine_version         = "8.4"
# db_parameter_group_family = "mysql8.4"
